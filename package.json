{
  "name": "diagram-studio",
  "version": "1.0.0",
  "description": "Turn plain-English descriptions into Mermaid diagrams with a local or hosted LLM.",
  "license": "MIT",
  "author": "Navansh",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "keywords": [
    "mermaid",
    "diagram",
    "llm",
    "ollama",
    "ai"
  ],
  "scripts": {
    "start": "node server/server.mjs",
    "test": "node --test test/*.test.mjs",
    "e2e": "node scripts/e2e.mjs",
    "licenses": "node scripts/licenses.mjs"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "dompurify": "^3.4.17",
    "lucide": "^1.61.0",
    "mermaid": "^12.2.0"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1"
  }
}
