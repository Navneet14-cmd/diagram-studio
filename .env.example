# Diagram Studio configuration. Copy to .env and adjust. Never commit .env.

# --- Model provider ---------------------------------------------------------
# "ollama" (local, default) or "openai" (any OpenAI-compatible API)
PROVIDER=ollama
# Ollama: http://localhost:11434
# OpenAI-compatible: include the /v1 suffix, e.g. https://api.openai.com/v1
BASE_URL=http://localhost:11434
MODEL=qwen2.5-coder:7b
# Server-side key for hosted providers. Never sent to the browser.
API_KEY=

# --- Server -----------------------------------------------------------------
# 127.0.0.1 = only this machine. Use 0.0.0.0 in containers or to listen on your network.
HOST=127.0.0.1
PORT=8787

# --- Limits -----------------------------------------------------------------
# Requests per IP per window for the AI endpoints (0 disables)
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
# Set to true only behind a reverse proxy you control (uses X-Forwarded-For for the client IP)
TRUST_PROXY=false
MAX_PROMPT_CHARS=2000
MAX_CODE_CHARS=12000
MAX_BODY_KB=32
# Cap on generated tokens per request (256-4000)
MAX_TOKENS=1500
# Abort a model call after this many milliseconds
LLM_TIMEOUT_MS=120000

# --- Privacy and keys -------------------------------------------------------
# Log prompt text to stdout (off by default; only request path/status/timing are logged)
LOG_PROMPTS=false
# Let visitors paste their own OpenAI-compatible key in the UI (PROVIDER=openai only).
# The key stays in their browser tab's memory and is never stored or logged by the server.
ALLOW_USER_KEYS=false
